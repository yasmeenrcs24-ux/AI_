board = [" " for _ in range(9)]

def display_board():
    print()
    print(board[0], "|", board[1], "|", board[2])
    print("--+---+--")
    print(board[3], "|", board[4], "|", board[5])
    print("--+---+--")
    print(board[6], "|", board[7], "|", board[8])
    print()

def check_winner(player):

    if board[0] == board[1] == board[2] == player:
        return True
    if board[3] == board[4] == board[5] == player:
        return True
    if board[6] == board[7] == board[8] == player:
        return True


    if board[0] == board[3] == board[6] == player:
        return True
    if board[1] == board[4] == board[7] == player:
        return True
    if board[2] == board[5] == board[8] == player:
        return True


    if board[0] == board[4] == board[8] == player:
        return True
    if board[2] == board[4] == board[6] == player:
        return True

    return False

def check_draw():
    return " " not in board


print("TIC-TAC-TOE")
print("Positions are numbered from 1 to 9")

while True:
    display_board()


    position = int(input("Player X, enter position (0-8): "))

    if position < 0 or position > 8:
        print("Invalid position!")
        continue

    if board[position] != " ":
        print("Position already occupied!")
        continue

    board[position] = "X"

    if check_winner("X"):
        display_board()
        print("Player X wins!")
        break

    if check_draw():
        display_board()
        print("Game Draw!")
        break


    position = int(input("Player O, enter position (0-8 ): "))

    if position < 0 or position > 8:
        print("Invalid position!")
        continue

    if board[position] != " ":
        print("Position already occupied!")
        continue

    board[position] = "O"

    if check_winner("O"):
        display_board()
        print("Player O wins!")
        break

    if check_draw():
        display_board()
        print("Game Draw!")
        break
